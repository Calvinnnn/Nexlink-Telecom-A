
[
	{
		"id": "tricky_001",
		"description": "VIP customer but device is new and location changed",
		"input": {
			"account_id": "acc_003",
			"action": "PORT_OUT",
			"wallet_present": false,
			"wallet_location": null,
			"current_location": "country_B",
			"device_id": "dev-Z",
			"device_new": true,
			"is_vip": true
		},
		"notes": "VIP may bias decisions elsewhere; rules prioritize device+wallet/location indicators",
		"expected_label": "MEDIUM_RISK"
	},
	{
		"id": "tricky_002",
		"description": "Wallet present but locations are the same (false positive risk)",
		"input": {
			"account_id": "acc_001",
			"action": "RECHARGE",
			"wallet_present": true,
			"wallet_location": "country_A",
			"current_location": "country_A",
			"device_id": "dev-A"
		},
		"expected_label": "LOW_RISK",
		"notes": "Wallet present alone shouldn't trigger HIGH_RISK without mismatch"
	},
	{
		"id": "tricky_003",
		"description": "Conflicting signals: wallet location mismatch but account very old",
		"input": {
			"account_id": "acc_001",
			"action": "PORT_OUT",
			"wallet_present": true,
			"wallet_location": "country_B",
			"current_location": "country_A",
			"device_id": "dev-A",
			"account_age_days": 1000
		},
		"expected_label": "HIGH_RISK",
		"notes": "Wallet+location mismatch rule takes precedence"
	}
]
